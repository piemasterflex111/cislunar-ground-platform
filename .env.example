# Phase 2 local-development configuration.
#
# These static tokens are deliberately simple teaching credentials. They are
# not production-grade security. Phase 5 adds HTTPS, mutual Transport Layer
# Security (mTLS), certificate identities, and a secret-rotation exercise.

POSTGRES_DB=ground
POSTGRES_USER=ground
POSTGRES_PASSWORD=ground-local-password

VENDOR_TOKEN=local-phase2-vendor-token
OPERATOR_TOKEN=local-phase2-operator-token
ADMIN_TOKEN=local-phase2-admin-token

# Only these two HTTP listeners are published, and only on the local machine.
GROUND_API_HOST_PORT=8080
VENDOR_SIMULATOR_HOST_PORT=8081

# Zero disables automatic telemetry. Use the simulator's send-once endpoint for
# deterministic exercises. Set a positive number of seconds for continuous data.
SIM_AUTO_SEND_INTERVAL_SECONDS=0
